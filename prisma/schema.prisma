// DevTrack schema. Local-only, MariaDB 10.4 via XAMPP.
//
// Shape of the model, in one paragraph: a User owns Projects. Every upload or
// re-scan of a project writes one immutable ProjectSnapshot, and all measured
// data (language stats, per-file rows, dependencies) hangs off that snapshot
// rather than off the project. That is what makes the history charts possible --
// nothing measured is ever overwritten. Everything a person edits by hand
// (tasks, tech tags, completion target) hangs off the Project instead, because
// it describes current intent, not a past measurement.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// The leaderboard is the one place a standard user sees anything about
  /// another account, so it is opt-out per user. Only a display name and
  /// aggregate totals are ever exposed — never project names or file paths.
  showOnLeaderboard Boolean @default(true)

  projects     Project[]
  createdTasks Task[]
  activity     ActivityLogEntry[]
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum CompletionMode {
  /// Derived from weighted task completion.
  TASKS
  /// Whatever the owner typed in.
  MANUAL
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  completionMode      CompletionMode @default(TASKS)
  /// Only read when completionMode is MANUAL. 0-100.
  manualCompletionPct Int            @default(0)

  /// Per-file rows multiply fast (a few thousand files times every snapshot),
  /// so storing them is opt-in per project rather than the default.
  trackFiles Boolean @default(false)

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshots ProjectSnapshot[]
  tasks     Task[]
  techTags  TechTag[]
  activity  ActivityLogEntry[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Snapshots -- one per upload or re-scan, never mutated after creation
// ---------------------------------------------------------------------------

enum SnapshotSource {
  UPLOAD
  RESCAN
}

enum UploadKind {
  FOLDER
  ZIP
}

model ProjectSnapshot {
  id        String   @id @default(cuid())
  projectId String
  createdAt DateTime @default(now())

  source     SnapshotSource
  uploadKind UploadKind
  /// Folder name or original .zip filename, for the activity feed.
  sourceName String

  /// Counts exclude node_modules, build output, lockfiles and binaries.
  totalFiles Int
  totalLines Int
  /// BigInt, not Int: uploads have no size limit, and Int would cap a project
  /// at ~2.1 GB of counted text. Read back through Number() at the query
  /// boundary — a bigint cannot cross into a client component.
  totalBytes BigInt

  /// Completion % captured at snapshot time. Denormalised on purpose: task
  /// state changes independently of uploads, so the history chart needs the
  /// value as it stood when the snapshot was taken.
  completionPct Float

  /// Whether the findings scan ran for this snapshot.
  ///
  /// Needed because "no findings" and "never checked" are indistinguishable
  /// from an empty SnapshotFinding set, and every snapshot taken before
  /// findings existed is the second one. Defaulting to false is what makes the
  /// backfill correct: old rows really were not scanned, and the panel says so
  /// instead of claiming the files all parse.
  findingsScanned Boolean @default(false)

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageStats LanguageStat[]
  files         SnapshotFile[]
  dependencies  Dependency[]
  findings      SnapshotFinding[]
  activity      ActivityLogEntry[]

  @@index([projectId, createdAt])
}

model LanguageStat {
  id         String @id @default(cuid())
  snapshotId String

  /// Analyzer output, e.g. "TypeScript". Percentages are derived at read time
  /// from these raw counts, never stored.
  language  String
  fileCount Int
  lines     Int
  bytes     BigInt

  snapshot ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, language])
}

model SnapshotFile {
  id         String @id @default(cuid())
  snapshotId String

  /// Repo-relative path. Stored as TEXT because paths outrun any sane VARCHAR,
  /// with a sha256 of the path carrying the uniqueness constraint -- utf8mb4
  /// index keys cap out around 768 chars, so the path itself cannot be indexed.
  path     String @db.Text
  pathHash String @db.Char(64)

  language String?
  lines    Int
  bytes    BigInt

  snapshot ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, pathHash])
  @@index([snapshotId, language])
}

enum PackageManager {
  NPM
  PIP
  GO
  CARGO
  COMPOSER
  OTHER
}

enum DependencyScope {
  RUNTIME
  DEV
  PEER
  OPTIONAL
}

model Dependency {
  id         String @id @default(cuid())
  snapshotId String

  name       String
  /// The declared range, verbatim ("^19.2.0"), not a resolved version.
  version    String?
  manager    PackageManager
  scope      DependencyScope @default(RUNTIME)
  /// Which manifest it came from, e.g. "package.json".
  sourceFile String

  snapshot ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, manager, name, scope])
  @@index([snapshotId])
}

enum FindingSeverity {
  ERROR
  WARN
  INFO
}

/// Something DevTrack can say is wrong, as opposed to measured.
///
/// Snapshot-scoped and immutable, exactly like Dependency: a finding is a fact
/// about one upload, so re-scanning writes a new set rather than mutating this
/// one, and "when did this break" answers itself from the series.
///
/// There is no dismiss flag. A finding is derived from the code, so the way to
/// clear one is to fix the file and re-scan -- unlike a TechTag, which is a
/// guess a person is entitled to overrule.
model SnapshotFinding {
  id         String @id @default(cuid())
  snapshotId String

  /// Stable slug ("json-invalid", "env-not-ignored") so the same problem is
  /// recognisable across snapshots even if its wording changes.
  rule     String
  severity FindingSeverity
  title    String
  /// Why it matters and what to do, as prose. @db.Text because the advice
  /// outgrows a VARCHAR and is never indexed or searched.
  detail   String  @db.Text
  /// The file it concerns, or null for a whole-project observation. TEXT for
  /// the same reason as SnapshotFile.path.
  path     String? @db.Text

  snapshot ProjectSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, severity])
}

// ---------------------------------------------------------------------------
// Human-edited state -- lives on Project, not on a snapshot
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id        String  @id @default(cuid())
  projectId String
  title     String
  notes     String? @db.Text

  status TaskStatus @default(TODO)
  /// Lets a milestone count for more than a chore in the completion figure.
  weight Int        @default(1)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([createdById])
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  /// Hosted platforms and managed services -- AWS, Firebase, Supabase, Vercel.
  ///
  /// Its own category rather than OTHER because "this project depends on
  /// somebody else's infrastructure" is a different fact about a codebase than
  /// "it uses ESLint", and it is usually the fact you most want at a glance.
  /// Supabase and Firebase land here rather than in DATABASE: they do provide
  /// a database, but choosing them is a hosting decision, not a schema one.
  CLOUD
  OTHER
}

enum TechOrigin {
  DETECTED
  MANUAL
}

model TechTag {
  id        String @id @default(cuid())
  projectId String

  name     String
  category TechCategory
  origin   TechOrigin   @default(DETECTED)

  /// What gave it away, e.g. "package.json: react". Null for manual tags.
  evidence String? @db.Text

  /// A detection the owner rejected. Kept as a row so re-scans do not keep
  /// resurrecting it.
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category, name])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Activity feed
// ---------------------------------------------------------------------------

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  SNAPSHOT_UPLOADED
  SNAPSHOT_RESCANNED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  TECH_TAGS_UPDATED
  COMPLETION_TARGET_CHANGED
}

model ActivityLogEntry {
  id        String @id @default(cuid())
  projectId String

  type    ActivityType
  /// Pre-rendered one-line summary, so the feed needs no per-type formatter.
  summary String

  /// Type-specific extras (task id, LOC delta, and so on). MariaDB stores JSON
  /// as LONGTEXT, so treat this as opaque -- never filter or sort on it.
  metadata Json?

  /// Set when the entry refers to a specific snapshot.
  snapshotId String?
  /// Null once the acting user is deleted; the history entry survives.
  actorId    String?

  createdAt DateTime @default(now())

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot ProjectSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  actor    User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([snapshotId])
  @@index([actorId])
}
